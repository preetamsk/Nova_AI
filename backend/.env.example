# NOVA uses only the free Ollama service running on this computer.
# Copy this file to .env. There is no paid API key to add.
APP_ENV=development
DATABASE_URL=sqlite:///./nova.db
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep this value private when sharing NOVA publicly.
SESSION_SECRET=replace-with-a-random-32-character-or-longer-value
SESSION_COOKIE_NAME=nova_session
SESSION_TTL_SECONDS=2592000
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_PER_MINUTE=20

# NOVA Cloud AI Settings:
# For 24/7 cloud hosting on Render/Railway, get a free key:
# - Groq (Recommended, free, ultra-fast): https://console.groq.com/keys
# - Google Gemini (Free tier): https://aistudio.google.com/app/apikey
# - OpenRouter (Free models): https://openrouter.ai/keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional overrides:
# AI_PROVIDER=groq
# AI_MODEL=llama-3.3-70b-versatile
# AI_VISION_MODEL=llama-3.2-11b-vision-preview

# Local development fallback (Ollama):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen2.5:1.5b
OLLAMA_VISION_MODEL=moondream:latest
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
